<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Light variant of the palette, mirroring GruvboxLightColorScheme in
        ui/theme/Theme.kt. The dark values live in values-night/colors.xml under
        the same names.
    -->

    <!-- Primary Brand Color -->
    <color name="primary">#B57617</color>
    <color name="on_primary">#333333</color>

    <!-- Secondary Brand Color -->
    <color name="secondary">#8F6300</color>
    <color name="on_secondary">#FBF1DE</color>

    <!-- Tertiary Brand Color -->
    <color name="tertiary">#A47D52</color>
    <color name="on_tertiary">#FBF1DE</color>

    <!-- Error Color -->
    <color name="error">#AF3A1B</color>
    <color name="on_error">#FBF1DE</color>

    <!-- Background Colors -->
    <color name="background">#FDF6E3</color>
    <color name="surface">#FBF1DE</color>
    <color name="on_surface">#333333</color>

    <!-- Navigation Bar -->
    <color name="navigation_bar">#E8D9C1</color>

    <!-- Listening State Colors (for UI feedback) -->
    <color name="listening_active">#4CAF50</color>
    <color name="processing_active">#FFC107</color>
    <color name="speaking_active">#2196F3</color>
    <color name="error_state">#F44336</color>

    <!-- Material Design Reference Colors (for compatibility) -->
    <color name="purple_200">#FFB39D</color>
    <color name="purple_500">#FF6200EE</color>
    <color name="purple_700">#FF3700B3</color>
    <color name="teal_200">#FF03DAC5</color>
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>
</resources>
