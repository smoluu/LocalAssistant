<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Dark variant of the application theme. It must stay a Material3 theme with
        the same token names as the light one: this theme is what Android paints
        outside Compose - the splash screen, the permission prompts, the
        foreground-service notification and the voice interaction window - so it
        has to agree with GruvboxDarkColorScheme in ui/theme/Theme.kt.
    -->
    <style name="Theme.LocalAssistant" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Tertiary brand color -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/on_tertiary</item>

        <!-- Background colors -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
    </style>
</resources>
