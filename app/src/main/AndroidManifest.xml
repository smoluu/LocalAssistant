<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISSIONS REQUIRED FOR LOCAL AI VOICE ASSISTANT

        RECORD_AUDIO       - Capture microphone input for wake word, speech recognition
        FOREGROUND_SERVICE_MICROPHONE - Run foreground service with mic (API 34+)
        POST_NOTIFICATIONS - Show persistent notification for always-on listening mode
        FOREGROUND_SERVICE - General foreground service permission (required on all API levels)

        BROADCAST_STICKY   - For internal service communication
        QUERY_ALL_PACKAGES - Not needed, removed if unused

        NOTE: Battery optimization exemption is requested at runtime, not declared here.
    -->

    <!-- Audio & Recording Permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network permissions for local endpoints -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wake lock to keep CPU awake during voice processing (optional, requested at runtime) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- For requesting battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Bluetooth for headset controls (optional enhancement) -->
    <!-- <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" /> -->

    <application
        android:name=".LocalAssistantApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAssistant"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            MAIN ACTIVITY - Chat & Voice Interface
            This is the primary UI for chat history and settings.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            VOICE ASSISTANT FOREGROUND SERVICE

            This service handles:
            - Wake word detection (openWakeWord)
            - Speech recognition (STT endpoint)
            - LLM chat completion
            - TTS audio playback

            Runs continuously in the background with a persistent notification.
        -->
        <service
            android:name=".service.VoiceAssistantService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!--
            WAKE WORD DETECTION SERVICE (Alternative/Additional)

            A lighter-weight service dedicated to wake word detection.
            Can run independently or as part of VoiceAssistantService.
        -->
        <service
            android:name=".service.WakeWordDetectionService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!--
            BOOT COMPLETED RECEIVER

            Restarts the voice assistant service after device reboot.
        -->
        <receiver
            android:name=".receiver.AppBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

        <!--
            NETWORK STATE RECEIVER

            Restarts listening when network becomes available.
        -->
        <receiver
            android:name=".receiver.NetworkStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!--
            VOICE ASSISTANT HOME SCREEN WIDGET

            Provides a quick-access microphone button on the home screen
            to start/stop the voice assistant service.
        -->
        <receiver
            android:name=".widget.VoiceAssistantWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_voice_assistant" />
        </receiver>

        <!--
            XML Resource for Network Security Config

            Allows cleartext HTTP traffic to local network endpoints.
        -->
        <meta-data
            android:name="com.google.android.gms.security.provider"
            android:value="" />

    </application>

</manifest>
