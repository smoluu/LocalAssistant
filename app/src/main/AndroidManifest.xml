<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        PERMISSIONS REQUIRED FOR LOCAL AI VOICE ASSISTANT

        RECORD_AUDIO       - Capture microphone input for wake word, speech recognition
        FOREGROUND_SERVICE_MICROPHONE - Run foreground service with mic (API 34+)
        POST_NOTIFICATIONS - Show persistent notification for always-on listening mode
        FOREGROUND_SERVICE - General foreground service permission (required on all API levels)

        BROADCAST_STICKY   - For internal service communication
        QUERY_ALL_PACKAGES - Not needed, removed if unused

        NOTE: Battery optimization exemption is requested at runtime, not declared here.
    -->

    <!-- Audio & Recording Permissions -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Network permissions for local endpoints -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Wake lock to keep CPU awake during voice processing (optional, requested at runtime) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- For requesting battery optimization exemption -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
        BIND_VOICE_INTERACTION is not a runtime permission and is not declared here:
        it is the capability a service declares on itself with android:permission on
        its <service> element (see the wake chat service below). The platform reads
        that annotation - VoiceInteractionServiceInfo rejects a service whose
        ServiceInfo.permission is not android.permission.BIND_VOICE_INTERACTION,
        which is what kept this app out of the "Default digital assistant" picker.
    -->

    <!-- Bluetooth for headset controls (optional enhancement) -->
    <!-- <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" /> -->

    <application
        android:name=".LocalAssistantApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.LocalAssistant"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!--
            MAIN ACTIVITY - Chat & Voice Interface
            This is the primary UI for chat history and settings.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustPan">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            VOICE ASSISTANT FOREGROUND SERVICE

            This service handles:
            - Wake word detection (the on-device matcher in ui/common/WakeWordDetector.kt)
            - Speech recognition (STT endpoint)
            - LLM chat completion
            - TTS audio playback

            Runs continuously in the background with a persistent notification.
        -->
        <service
            android:name=".service.VoiceAssistantService"
            android:foregroundServiceType="microphone"
            android:exported="false" />

        <!--
            WAKE CHAT SERVICE

            The hands-free service behind the wake-word overlay. It runs the whole
            pipeline (record -> on-device wake-word match -> STT -> LLM -> TTS) in
            the background, so the conversation keeps working while the app is
            minimized. Its persistent notification carries the reply and reopens the
            app when tapped.

            The intent-filter declares the voice-interaction interface, which is
            what lets a platform that hosts hands-free conversations instantiate
            this class as its own voice service and draw the exchange over the
            system UI and whatever app the device is showing.

            The meta-data item points at the resource that names this service and
            the session service that draws its exchanges; without it the platform
            has no way to find the session half.

            The service is exported: an assistant picker that runs in another
            package - the system "Default digital assistant" selector - only sees
            activities that are exported to it, so exported="false" here hides the
            app from that picker entirely.

            android:permission is the capability the platform requires before it
            will treat this service as an assistant at all: VoiceInteractionServiceInfo
            answers "Service does not require permission android.permission.BIND_VOICE_INTERACTION"
            for any service that does not declare it, and the whole voice-interaction
            path - the picker's list, onReady(), showSession() - is dead until it does.
        -->
        <service
            android:name=".service.WakeChatService"
            android:foregroundServiceType="microphone"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/voice_interaction" />
        </service>

        <!--
            WAKE CHAT SESSION SERVICE

            The drawing half of the wake pipeline. The system instantiates this
            class when it wants to show a voice exchange and composes the window
            it returns into a window of type TYPE_VOICE_INTERACTION, which sits
            over the home screen or over whatever app the device is showing - the
            only place the wake chat can appear while the app is minimized.

            It deliberately shares the app's own process. AOSP's class docs
            suggest a separate process, and the tab does start one ("Start proc
            …WakeChatSessionService … for service {…}"), but the framework's
            onCreate() resolves the VoiceInteractionManagerService through the
            service registry of *that* process, which in an isolated process
            holds only this service - so the field stays null and the very next
            framework call, deliverSession, throws
            "NullPointerException … 'IVoiceInteractionManagerService.deliverNewSession'
            on a null object reference", which is the "LocalAssistant has stopped"
            dialog the user sees on every exchange. The manager service is
            resolvable only in the process that hosts the voice-interaction
            service itself, which is where VoiceInteractionService.onReady()
            resolves it from, so the two halves have to share it.
        -->
        <service
            android:name=".service.WakeChatSessionService"
            android:exported="true" />

        <!--
            BOOT COMPLETED RECEIVER

            Restarts the voice assistant service after device reboot.
        -->
        <receiver
            android:name=".receiver.AppBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.REBOOT" />
            </intent-filter>
        </receiver>

        <!--
            NETWORK STATE RECEIVER

            Restarts listening when network becomes available.
        -->
        <receiver
            android:name=".receiver.NetworkStateReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!--
            VOICE ASSISTANT HOME SCREEN WIDGET

            Provides a quick-access microphone button on the home screen
            to start/stop the voice assistant service.
        -->
        <receiver
            android:name=".widget.VoiceAssistantWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_voice_assistant" />
        </receiver>

        <!--
            XML Resource for Network Security Config

            Allows cleartext HTTP traffic to local network endpoints.
        -->
        <meta-data
            android:name="com.google.android.gms.security.provider"
            android:value="" />

    </application>

</manifest>
